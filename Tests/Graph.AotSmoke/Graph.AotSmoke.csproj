<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\Samples\*\Assets\*.graph.json" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Samples\Graph.Samples.Shader\Graph.Samples.Shader.csproj"/>
        <ProjectReference Include="..\..\Samples\Graph.Samples.Fsm\Graph.Samples.Fsm.csproj"/>
        <ProjectReference Include="..\..\Samples\Graph.Samples.Compositor\Graph.Samples.Compositor.csproj"/>
        <ProjectReference Include="..\..\Graph.Interpreter\Graph.Interpreter.csproj"/>
    </ItemGroup>
</Project>
