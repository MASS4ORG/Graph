<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>MASS4.Graph.Samples.Fsm</AssemblyName>
        <RootNamespace>MASS4.Graph.Samples.Fsm</RootNamespace>
        <Description>Contract sample: a guard state machine with cyclic states, a self-transition, typed triggers, dataflow guards and timed transitions, run as one asset across many instances.</Description>
        <IsPackable>false</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="Assets/*.graph.json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Graph.Generator\Graph.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\Graph.Dataflow\Graph.Dataflow.csproj" />
        <ProjectReference Include="..\..\Graph.State\Graph.State.csproj" />
    </ItemGroup>

</Project>
